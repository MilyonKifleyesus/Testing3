{
  "name": "spruha",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:timesheet-mock": "echo [NON-DEFAULT] Emergency timesheet mock mode && ng serve --proxy-config proxy.inspectors.mock.conf.json",
    "mock:timesheet-api": "echo [NON-DEFAULT] Emergency mock API source && npx -y json-server --watch public/assets/data/inspectors.json --port 3001",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "verify:admin:api": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-admin-dashboard-api.ps1",
    "verify:admin:ui": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-admin-dashboard-ui.ps1",
    "verify:admin:all": "npm run verify:admin:api && npm run verify:admin:ui",
    "verify:fluorescence-map:ui": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-fluorescence-map-ui.ps1",
    "verify:fluorescence-map:video": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-testsprite-fluorescence-map.ps1 -VideoUrlOutputPath ./output/playwright/verification-video.url.txt",
    "verify:fluorescence-map:all": "npm run verify:fluorescence-map:ui",
    "sass": "sass ./public/assets/scss:./public/assets/css/",
    "sass-min": "sass ./public/assets/scss:./public/assets/css/ --style compressed"
  },
  "private": true,
  "dependencies": {
